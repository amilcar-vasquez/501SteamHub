{{ define "htmlBody" }}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background-color: #e8f5e9; padding: 20px; border-radius: 5px; margin-bottom: 20px; border-left: 4px solid #4caf50; }
        .header h2 { color: #2e7d32; margin: 0; }
        .content { margin: 20px 0; }
        .info-box { padding: 15px; background-color: #f5f5f5; border-left: 4px solid #2196f3; margin: 15px 0; }
        .security-note { padding: 15px; background-color: #fff3e0; border-left: 4px solid #ff9800; margin: 15px 0; }
        .footer { font-size: 12px; color: #666; margin-top: 30px; padding-top: 20px; border-top: 1px solid #ddd; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>Email Address Updated</h2>
            <p>Your account email has been successfully changed.</p>
        </div>
        
        <div class="content">
            <p>Hello {{.Username}},</p>
            <p>Your email address for the 501 STEAM Hub has been successfully changed.</p>
            
            <div class="info-box">
                <p><strong>New Email Address:</strong></p>
                <p>{{.NewEmail}}</p>
            </div>
            
            <div class="security-note">
                <p><strong>⚠️ Security Notice:</strong></p>
                <p>If you did not authorize this email change, please contact the 501 STEAM Hub support team immediately. Your account may have been compromised.</p>
            </div>
            
            <p>Future communications from 501 STEAM Hub will be sent to your new email address.</p>
        </div>
        
        <div class="footer">
            <p>501 STEAM Hub | Security Team</p>
        </div>
    </div>
</body>
</html>
{{ end }}
