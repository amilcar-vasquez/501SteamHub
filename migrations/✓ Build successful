 created_at     | timestamp without time zone |           |          | CURRENT_TIMESTAMP
 updated_at     | timestamp without time zone |           |          | CURRENT_TIMESTAMP
Indexes:
    "ilos_pkey" PRIMARY KEY, btree (id)
    "idx_ilos_cycle_id" btree (cycle_id)
    "idx_ilos_grade_level_id" btree (grade_level_id)
    "idx_ilos_ilo_code" btree (ilo_code)
    "idx_ilos_strand_id" btree (strand_id)
    "idx_ilos_subject_grade_cycle" btree (subject_id, grade_level_id, cycle_id)
